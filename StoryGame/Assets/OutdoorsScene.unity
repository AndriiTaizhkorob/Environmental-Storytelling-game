--- !u!114 &8575910182523455140
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7783131305496602486}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 190c92c32ecfb5943982286463bdd245, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotePopUp
  letterUI: {fileID: 839769747}
  letterText: {fileID: 170560571}
  text: "Greetings brother,\n\nI hope you are doing well. As for me, everything is
    fine. I have been helping around much more since you left. Recently, a newcomer
    arrived in our village. The first thing I noticed about him was his unusual attire,
    as it combined pieces of clothing from different places. Some of them I recognised,
    like the tippet of a dark colour around his neck, similar to what many people
    from the far North-West wear, some I did not, like that strange cloth covering
    his head, leaving only his face open, and they were all worn out and dirty. He
    must be a traveller from afar. I wonder what stories he has to tell. I have to
    ask him someday. So, I am doing my best to stay in high spirits. Hope to hear
    from you soon!  \n\n-George"
